# Obrigatorias
DATABASE_URL=postgresql://auth:auth@localhost:5433/auth?schema=public

# Chave RSA de assinatura (RS256, PKCS#8, >= 2048 bits). Exatamente uma das duas:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing-key.pem
AUTH_PRIVATE_KEY_FILE=./signing-key.pem
# AUTH_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Opcionais (valores padrao)
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
AUTH_ISSUER=ms-auth
AUTH_AUDIENCE=ms-platform
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Limpeza periodica: familias de refresh tokens vencidas ha mais que a retencao
REFRESH_TOKEN_CLEANUP_INTERVAL_MS=3600000
REFRESH_TOKEN_RETENTION_SECONDS=86400
REFRESH_TOKEN_CLEANUP_BATCH_SIZE=1000
# Admin inicial, criado no boot se ainda nao existir (os dois ou nenhum)
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@ms-platform.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_LOGIN_LIMIT=10
HEALTH_CHECK_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=10000

# So para autoria de migration (prisma migrate dev --create-only)
# SHADOW_DATABASE_URL=postgresql://auth:auth@localhost:5433/auth_shadow?schema=public
